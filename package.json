{
  "name": "@adaptic/gitnexus",
  "version": "0.1.0",
  "description": "Cross-repo awareness, diagnostics, and guardrails for the Adaptic.ai monorepo ecosystem",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gitnexus": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "gitnexus.config.example.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "git",
    "monorepo",
    "cli",
    "claude-code",
    "adaptic",
    "developer-tools"
  ],
  "author": "Adaptic.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adapticai/gitnexus.git"
  }
}
